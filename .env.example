NODE_ENV=development
PORT=3001

# Auth DB (PostgreSQL)
DATABASE_URL=postgres://banklite:banklite@localhost:5432/auth_db

# JWT
JWT_SECRET=super-secreto-cambiar-en-produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ (bus de eventos asíncrono)
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
RABBITMQ_EXCHANGE=banklite.events

# KYC Service (POST /auth/register confirma allí que la identidad esté verificada)
KYC_SERVICE_URL=http://localhost:3003
# Clave compartida con KYC Service; debe ser idéntica a su INTERNAL_API_KEY.
INTERNAL_API_KEY=clave-interna-cambiar-en-produccion
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Gmail SMTP + Nodemailer (POST /auth/email/send y /auth/email/verify)
# Usa una App Password de Gmail (cuenta con verificación en 2 pasos activa),
# nunca la contraseña normal de la cuenta.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Firebase Admin (POST /auth/phone/verify)
# Credenciales del "service account" del proyecto Firebase (Project Settings
# > Service accounts > Generate new private key). FIREBASE_PRIVATE_KEY debe
# conservar los saltos de línea como \n si se pega en una sola línea de .env.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
