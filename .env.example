NODE_ENV=development
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
PORT=3001

# Auth DB (PostgreSQL)
DATABASE_URL=postgres://auth_svc:<DB_PASSWORD_AUTH>@localhost:5432/auth_db

# JWT
JWT_SECRET=
STAFF_JWT_SECRET=
# Semilla de la clave dinámica; independiente de JWT_SECRET.
DYNAMIC_KEY_SECRET=
PASSWORD_PEPPER=
# Firma del ticket de cierre de cuenta (5 min, un solo uso); distinto de JWT_SECRET.
# El mismo valor va en account-service, que verifica el ticket. Vacío: no se puede cancelar.
CLOSURE_TICKET_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ (bus de eventos asíncrono)
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events

# KYC Service (POST /auth/register confirma allí que la identidad esté verificada)
KYC_SERVICE_URL=http://localhost:3003
# Clave interna PROPIA de auth-service (la aceptan kyc-service, notification-service y fraud-service).
INTERNAL_API_KEY=
# Quién puede llamar a /internal/dynamic-key/verify: transfer-service.
INTERNAL_TRUSTED_KEYS=transfer:<clave-de-transfer>
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Opcional: a quién reportar cada inicio de sesión con la IP del cliente (geolocalización
# en fraud-service, que acepta la INTERNAL_API_KEY de auth como auth:<clave>). Vacía: no se reporta.
FRAUD_SERVICE_URL=http://localhost:3009

# Gmail API (POST /auth/email/send, recuperación de clave y alertas de seguridad).
# Credenciales OAuth2 con el permiso gmail.send; cómo obtenerlas: README.md, sección 7.2.
# GMAIL_SENDER es la cuenta de Gmail que autorizó el refresh token (siempre es el remitente).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Opcionales (estos son los valores por defecto).
# Primer administrador del panel: se crea al arrancar si no hay empleados (clave de 12+ caracteres).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Duración de la sesión de los empleados.
STAFF_JWT_EXPIRES_IN=8h
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1
